{
  "name": "@tallyline/mcp-server",
  "version": "0.1.0",
  "description": "Tallyline MCP server: issue tracker tools for AI agents (stdio and Streamable HTTP)",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "issue-tracker",
    "agents",
    "tallyline"
  ],
  "type": "module",
  "bin": {
    "tallyline-mcp": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --outdir=dist --external:@modelcontextprotocol/sdk --external:zod",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests --no-file-parallelism",
    "prepack": "pnpm build",
    "prebuild": "rm -rf dist"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tallyline/api": "workspace:*",
    "tsx": "^4.23.15",
    "@tallyline/types": "workspace:*",
    "esbuild": "^0.25.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/duketopceo/docketry.git",
    "directory": "apps/mcp-server"
  },
  "homepage": "https://github.com/duketopceo/docketry#readme",
  "bugs": {
    "url": "https://github.com/duketopceo/docketry/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ]
}
