# ── Core ─────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/docketry
REDIS_URL=redis://localhost:6380
API_PORT=4000
# Public base URL of this API — used in the GitHub App manifest
API_BASE_URL=http://localhost:4000
# Required in production — signs short-lived access JWTs
JWT_SECRET=
# Requests per minute per token/IP (0 disables)
RATE_LIMIT_PER_MIN=600
NEXT_PUBLIC_API_URL=http://localhost:4000

# ── GitHub App (issue sync / PR linking) ─────────────
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# also enables "Sign in with GitHub" when SECRET is set
# (the App's OAuth client credentials double as the provider's)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Auth & SSO ───────────────────────────────────────
# Public web origin — OAuth callbacks land here
WEB_URL=http://localhost:3100
# AES-256-GCM key for provider client_secrets stored in the DB —
# `openssl rand -base64 32`. Losing/rotating it makes existing
# DB-stored secrets undecryptable (re-enter them in settings)
AUTH_SECRET_KEY=
# Comma-separated emails that are instance admins (provider CRUD).
# When unset, the bootstrap workspace owner is the fallback admin
AUTH_ADMIN_EMAILS=
# 1 = hide password login (SSO-only installs)
#AUTH_DISABLE_PASSWORD=
# auto | login | disabled — when a provider sign-in matches an
# existing verified email, link the identity silently / require
# a pending-link proof / never link
#AUTH_ACCOUNT_LINKING=auto
# Comma-separated domains allowed to create accounts via OAuth
# (empty = any domain). Workspace invites bypass this
#AUTH_ALLOWED_EMAIL_DOMAINS=
# Default on: a brand-new OAuth user auto-joins the workspace when
# the instance has exactly one. WARNING — on internet-facing
# installs this is open membership: set 0 unless invited-only
#AUTH_AUTO_JOIN_SINGLE_WORKSPACE=0
# 1 = trust x-forwarded-for in rate limits/logs — set only behind
# a real reverse proxy (spoofable otherwise)
#TRUSTED_PROXY=

# ── OAuth providers ──────────────────────────────────
# Any provider left empty is simply absent from the login page.
# Env-configured providers shadow DB rows of the same key and
# can't be edited in settings — see docs/auth.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generic OIDC — discovery via ${OIDC_ISSUER}/.well-known/…
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_DISPLAY_NAME=
# space-separated, always includes `openid`
OIDC_SCOPES=email profile

# ── Slack (notifications / commands) ─────────────────
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_APP_TOKEN=
# docketry workspace the app reports into (self-host binding)
SLACK_WORKSPACE_SLUG=
# reaction that drafts an issue from a thread
SLACK_INTAKE_EMOJI=ticket

# ── Third-party integrations ─────────────────────────
COMPOSIO_API_KEY=
LINEAR_API_KEY=

# ── LLM assist (opt-in; empty = all surfaces off) ────
# OpenRouter or any OpenAI-compatible /chat/completions endpoint
DOCKETRY_LLM_API_KEY=
DOCKETRY_LLM_BASE_URL=https://openrouter.ai/api/v1
DOCKETRY_LLM_MODEL=google/gemini-2.5-flash-lite

# ── Self-host only (docker-compose.selfhost.yml) ─────
# Required there — password for the internal postgres
POSTGRES_PASSWORD=
#POSTGRES_USER=postgres
#POSTGRES_DB=docketry
# host ports the services bind
#WEB_PUBLISH_PORT=3100
#API_PUBLISH_PORT=4000
# server-side API origin inside the compose network — already
# set to http://api:4000 in the compose file; override only for
# exotic topologies
#API_INTERNAL_URL=http://api:4000
