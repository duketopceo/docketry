{
  "name": "@docketry/composio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Composio custom toolkit for docketry — DOCKETRY_* tools over the docketry REST API",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@composio/core": ">=0.22.0 <1",
    "zod": ">=3.25.76 <5"
  },
  "devDependencies": {
    "@composio/core": "0.22.0",
    "vitest": "^5.0.3",
    "zod": "^4.6.5"
  }
}
