{
  "name": "n8n-nodes-tallyline",
  "version": "0.1.0",
  "description": "n8n community nodes for tallyline — issue ops plus a signed outbound-webhook trigger",
  "license": "MIT",
  "homepage": "https://github.com/duketopceo/tallyline",
  "author": "duketopceo",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "tallyline",
    "issue-tracker"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/duketopceo/tallyline.git",
    "directory": "integrations/n8n"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/TallylineApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Tallyline/Tallyline.node.js",
      "dist/nodes/TallylineTrigger/TallylineTrigger.node.js"
    ]
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "n8n-workflow": "^2.16.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
